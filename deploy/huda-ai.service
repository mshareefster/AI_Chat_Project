[Unit]
Description=Huda AI FastAPI backend
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/huda-ai/backend
EnvironmentFile=/var/www/huda-ai/backend/.env
ExecStart=/var/www/huda-ai/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
