
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        EC2_HOST = '43.204.3.21'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build React Frontend') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Validate Backend') {
            steps {
                dir('backend') {
                    sh '''
                        set -e
                        python3 -m py_compile main.py
                        test -f main.py
                        echo "Backend validation passed."
                    '''
                }
            }
        }

        stage('Archive Build') {
            steps {
                archiveArtifacts(
                    artifacts: 'frontend/dist/**,backend/main.py',
                    fingerprint: true
                )
            }
        }

        stage('Manual Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: 'CI checks passed. Deploy Huda AI to production EC2?',
                        ok: 'Approve Production Deployment'
                    )
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-deploy-key',
                        keyFileVariable: 'SSH_KEY',
                        usernameVariable: 'SSH_USER'
                    )
                ]) {
                    sh '''
                        set -eu

                        REMOTE_STAGE="/tmp/huda-ai-release-${BUILD_NUMBER}"

                        echo "Preparing remote staging directory..."

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o BatchMode=yes \
                            "$SSH_USER@$EC2_HOST" \
                            "mkdir -p '$REMOTE_STAGE'"

                        echo "Transferring React build..."

                        scp -r -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o BatchMode=yes \
                            frontend/dist \
                            "$SSH_USER@$EC2_HOST:$REMOTE_STAGE/"

                        echo "Transferring backend source..."

                        scp -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o BatchMode=yes \
                            backend/main.py \
                            "$SSH_USER@$EC2_HOST:$REMOTE_STAGE/"

                        echo "Starting production deployment..."

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o BatchMode=yes \
                            "$SSH_USER@$EC2_HOST" \
                            "sudo bash -s -- '$BUILD_NUMBER'" <<'REMOTE_SCRIPT'

set -Eeuo pipefail

BUILD_ID="$1"

APP="/huda-ai"
STAGE="/tmp/huda-ai-release-$BUILD_ID"
BACKUP_DIR="/var/backups/huda-ai"

NEW_DIST="$APP/frontend/dist.new-$BUILD_ID"
OLD_DIST="$APP/frontend/dist.old-$BUILD_ID"

BACKUP="$BACKUP_DIR/deploy-$BUILD_ID-$(date +%Y%m%d-%H%M%S).tar.gz"

echo "Checking production files..."

test -f "$STAGE/main.py"
test -f "$STAGE/dist/index.html"
test -f "$APP/backend/.env"
test -x "$APP/backend/venv/bin/python"
test -d "$APP/frontend/dist"

AVAILABLE_MB=$(df -Pm / | awk 'NR==2 {print $4}')

if [ "$AVAILABLE_MB" -lt 300 ]; then
    echo "Not enough disk space for deployment."
    exit 1
fi

echo "Checking backend with production Python..."

"$APP/backend/venv/bin/python" \
    -m py_compile "$STAGE/main.py"

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

echo "Creating production backup..."

tar -czf "$BACKUP" \
    -C "$APP" \
    backend/main.py \
    frontend/dist

chmod 600 "$BACKUP"

echo "Verifying backup..."

tar -tzf "$BACKUP" >/dev/null

echo "Backup verified: $BACKUP"

echo "Preparing new frontend..."

rm -rf "$NEW_DIST" "$OLD_DIST"

cp -a "$STAGE/dist" "$NEW_DIST"

chown -R root:root "$NEW_DIST"

echo "Defining rollback procedure..."

rollback() {
    STATUS=$?

    trap - ERR
    set +e

    echo "======================================"
    echo "DEPLOYMENT FAILED - STARTING ROLLBACK"
    echo "======================================"

    rm -rf "$APP/frontend/dist"

    if tar -xzf "$BACKUP" -C "$APP"; then

        echo "Previous application files restored."

        systemctl restart huda-ai.service

        sleep 3

        if curl -fsS \
            http://127.0.0.1:8000/api/health; then
            echo "Previous backend is healthy."
        else
            echo "WARNING: Backend health check failed after rollback."
        fi

        rm -rf "$NEW_DIST" "$OLD_DIST" "$STAGE"

        echo "Rollback completed."
        echo "Backup retained at: $BACKUP"

    else
        echo "CRITICAL: Backup restoration failed."
        echo "Manual recovery is required."
        echo "Backup location: $BACKUP"
        echo "Previous frontend may be available at: $OLD_DIST"

        exit 1
    fi

    exit "$STATUS"
}

echo "Enabling rollback protection..."

trap rollback ERR

echo "Deploying new frontend..."

mv "$APP/frontend/dist" "$OLD_DIST"

mv "$NEW_DIST" "$APP/frontend/dist"

echo "Deploying backend source..."

install -o root -g root -m 0644 \
    "$STAGE/main.py" \
    "$APP/backend/main.py"

echo "Restarting FastAPI..."

systemctl restart huda-ai.service

sleep 3

echo "Checking local backend health..."

curl -fsS \
    http://127.0.0.1:8000/api/health

echo

echo "Checking public API health..."

curl --connect-timeout 10 --max-time 30 -fsS \
    https://chat.hudamusthafa.tech/api/health

echo

echo "Checking chat website..."

CHAT_STATUS=$(curl --connect-timeout 10 --max-time 30 \
    -sS -o /dev/null -w "%{http_code}" \
    https://chat.hudamusthafa.tech)

test "$CHAT_STATUS" = "200"

echo "Chat website: HTTP $CHAT_STATUS"

echo "Checking agents website..."

AGENTS_STATUS=$(curl --connect-timeout 10 --max-time 30 \
    -sS -o /dev/null -w "%{http_code}" \
    https://agents.hudamusthafa.tech)

test "$AGENTS_STATUS" = "200"

echo "Agents website: HTTP $AGENTS_STATUS"

echo "All production health checks passed."

echo "Cleaning temporary deployment files..."

rm -rf "$OLD_DIST" "$STAGE"

trap - ERR

echo "======================================"
echo "DEPLOYMENT COMPLETED SUCCESSFULLY"
echo "======================================"

echo "Production backup: $BACKUP"

REMOTE_SCRIPT
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Huda AI production deployment completed successfully!'
        }

        failure {
            echo 'Deployment failed. Check Jenkins console output and EC2 backup.'
        }

        always {
            echo 'Deployment pipeline finished.'
        }
    }
}

